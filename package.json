{
  "name": "chakraindustries-backend",
  "version": "1.0.0",
  "description": "Sri Chakra Industries Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop chakra-erp",
    "pm2:restart": "pm2 restart chakra-erp",
    "pm2:reload": "pm2 reload chakra-erp",
    "pm2:logs": "pm2 logs chakra-erp",
    "pm2:save": "pm2 save",
    "tally:sync": "node scripts/tallySyncNow.js",
    "tally:fix-config": "node scripts/fixTallyConfig.js",
    "seed": "node seed.js",
    "seed:inventory": "node seedInventory.js",
    "seed:ageing": "node scripts/seedAgeingData.js",
    "seed:bom": "node scripts/seedBOM.js",
    "fix-bulk": "node scripts/fixBulkQuotations.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "nodemailer": "^6.9.14",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
